# Copia este archivo a .env y cambia TODOS los valores.
# Genera cada secreto con: openssl rand -hex 16
# No subas .env al repositorio ni lo incluyas en el ZIP de entrega.

COUCHDB_USER=admin
COUCHDB_PASSWORD=CAMBIAR_COUCHDB_PASSWORD
COUCHDB_SECRET=CAMBIAR_COUCHDB_SECRET
JWT_SECRET=CAMBIAR_JWT_SECRET_32_CARACTERES_MINIMO
JWT_ISSUER=trazabilidad-sandbox
JWT_TTL_S=3600
POSTGRES_PASSWORD=CAMBIAR_POSTGRES_PASSWORD

# Usuarios de la API (mismos en T y C0).
LOAD_PASS=CAMBIAR_LOAD_PASS
SIM_PASS=CAMBIAR_SIM_PASS
AUDIT_PASS=CAMBIAR_AUDIT_PASS
PROD_PASS=CAMBIAR_PROD_PASS

# Usuarios directos de CouchDB para probar el RBAC del motor (roles tecnico/productor/auditor).
# Los nombres son fijos: tec-c1, prod-1 y aud-1 (ver sandbox/couchdb/create_users.sh).
COUCH_TEC_PASS=CAMBIAR_COUCH_TEC_PASS
COUCH_PROD_PASS=CAMBIAR_COUCH_PROD_PASS
COUCH_AUD_PASS=CAMBIAR_COUCH_AUD_PASS

# Hardware: fija el mismo cpuset y memoria para los brazos T y C0.
# En una maquina de 4+ nucleos usa, por ejemplo, CPUSET=0-1 y LOAD_CPUSET=2-3.
# En esta maquina de 2 nucleos ambos comparten 0-1.
CPUSET=0-1
LOAD_CPUSET=0-1
MEM_LIMIT=768m
CLIENT_MEM_LIMIT=512m
PROM_MEM_LIMIT=256m
CADVISOR_MEM_LIMIT=256m
BASELINE_WORKERS=2
BASELINE_THREADS=16

# Parametros de la corrida (el runner los sobrescribe).
ARCH=treatment
ARCH_HOST=api-rust
DEVICES=10
SEED=1
RUN_SECONDS=300
WARMUP_S=30
MEASURE_S=240
DRAIN_S=120
OUTAGE_PLAN=60:30,180:30
OUTAGE_MODE=self
NETEM_BASE=
MEAN_INTERVAL_S=2.0
SYNC_BASE_S=5
SYNC_MAX_S=60
RUN_ID=
LOAD_VUS=500
LOAD_DURATION=240s
RAMP_UP=30s
RAMP_DOWN=30s
K6_STRICT=0
